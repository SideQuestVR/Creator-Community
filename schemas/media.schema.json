{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator Community Preview Galleries",
  "description": "Optional media.json sidecar. Keep listing.json and previewImage compatible with older apps. Maximum encoded file size: 256 KiB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "galleries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "galleries": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "items"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/media" } }
        }
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string", "maxLength": 2048,
      "pattern": "^(?:(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_-][A-Za-z0-9._-]*|https://(?:cdn\\.sidequestvr\\.com/file/|raw\\.githubusercontent\\.com/SideQuestVR/Creator-Community/main/)(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*)$"
    },
    "static": { "allOf": [{ "$ref": "#/$defs/url" }, { "pattern": "\\.(png|jpg|jpeg)$" }] },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "enum": ["image", "gif", "webm"] },
        "url": { "$ref": "#/$defs/url" },
        "poster": { "$ref": "#/$defs/static" }
      },
      "oneOf": [
        { "properties": { "type": { "const": "image" }, "url": { "$ref": "#/$defs/static" } }, "not": { "required": ["poster"] } },
        { "required": ["poster"], "properties": { "type": { "const": "gif" }, "url": { "pattern": "\\.gif$" } } },
        { "required": ["poster"], "properties": { "type": { "const": "webm" }, "url": { "pattern": "\\.webm$" } } }
      ]
    }
  }
}
