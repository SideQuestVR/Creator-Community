{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supplemental Creator Community downloads",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "downloads"],
  "properties": {
    "schemaVersion": {"const": 1},
    "downloads": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "download"],
        "properties": {
          "id": {"type": "string", "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9.-]*\\.[a-z0-9.-]+$"},
          "version": {"type": "string", "maxLength": 80, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
          "download": {
            "type": "object", "additionalProperties": false,
            "required": ["byteLength", "sha256"],
            "oneOf": [{"required": ["url"], "not": {"required": ["path"]}}, {"required": ["path"], "not": {"required": ["url"]}}],
            "properties": {
              "url": {"type": "string", "maxLength": 2048, "pattern": "^https://(?:cdn\\.sidequestvr\\.com/file/|raw\\.githubusercontent\\.com/SideQuestVR/Creator-Community/main/|github\\.com/)[^?#@]+\\.(?:unitypackage|zip)$"},
              "path": {"type": "string", "maxLength": 500, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)+\\.(?:unitypackage|zip)$"},
              "byteLength": {"type": "integer", "minimum": 1, "maximum": 268435456},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
